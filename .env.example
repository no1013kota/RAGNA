# Discord Developer Portalで再発行したBot Token
DISCORD_BOT_TOKEN=ここに新しいBot_Token

# 対象DiscordサーバーのID
DISCORD_GUILD_ID=ここにサーバーID

# 保存先を変えたいローカル環境だけ、次の行のコメントを外します。
# Railwayでは設定せず、Volumeのパスを自動検出させてください。
# DATABASE_PATH=data/ragna.db

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==================================================
# RAGNA Online（ギルド・使い魔・ギルドバトル）
# ==================================================
# パネルの設置とゲーム操作を有効にします。未設定またはfalseの間は
# Cogは読み込まれますが、パネルを設置しません（段階公開用）。
GAME_ENABLED=false

# ギルド紹介チャンネル（設立パネル・自分の参加申請の確認）
GUILD_INTRO_CHANNEL_ID=

# メンバー募集チャンネル（募集Embedと参加申請）。ギルド紹介とは別のチャンネル
GUILD_MEMBER_RECRUITMENT_CHANNEL_ID=

# 使い魔パネル（ガチャ／管理）を置くチャンネル
FAMILIAR_PANEL_CHANNEL_ID=

# 公開バトル募集チャンネル（募集Embedとランキングパネル）
GUILD_BATTLE_RECRUITMENT_CHANNEL_ID=

# 運営操作ログの転送先（任意）。未設定でもDBへは必ず記録します。
# バトルの進行ログは、対戦成立時にギルドカテゴリー内へ自動生成する
# 「バトル-<バトルID>」チャンネルへ投稿するため、事前の用意は不要です。
GAME_ADMIN_LOG_CHANNEL_ID=
